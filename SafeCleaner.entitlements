<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Entitlements for SafeCleaner (the cleaner branch).

  Same unsandboxing / container story as the inspector, except:
    - file exceptions are read-WRITE here, because this app deletes
    - and the list covers ONLY the directories it is allowed to clean:
      /tmp, /var/mobile/Library/Caches and per-container Library/Caches + tmp
  Everything the safety review marked "must not be deleted" (logs, downloads,
  Photos data, daemon / plugin / shared / system containers) is absent on
  purpose: the kernel denies the write before our code even runs, so it is not
  only a rule in the source, it is a rule enforced by the sandbox too.
-->
<dict>
    <key>platform-application</key>
    <true/>

    <key>com.apple.private.security.container-required</key>
    <false/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.sandbox</key>
    <false/>

    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <key>com.apple.private.MobileContainerManager.allowed</key>
    <true/>
    <key>com.apple.private.coreservices.canmaplsdatabase</key>
    <true/>

    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/</string>
        <string>/private/</string>
        <string>/tmp/</string>
        <string>/var/</string>
        <string>/var/tmp/</string>
        <string>/var/mobile/</string>
        <string>/var/mobile/Containers/</string>
        <string>/var/mobile/Containers/Data/</string>
        <string>/var/mobile/Containers/Data/Application/</string>
        <string>/var/mobile/Library/</string>
        <string>/var/mobile/Library/Caches/</string>
    </array>
    <key>com.apple.security.exception.files.home-relative-path.read-only</key>
    <array>
        <string>/</string>
    </array>
</dict>
</plist>
